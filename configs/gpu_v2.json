{
  "vocab_size": 8192,
  "block_size": 512,
  "n_embd": 640,
  "n_head": 10,
  "n_layer": 16,
  "mlp_ratio": 4,
  "dropout": 0.1,
  "batch_size": 4,
  "gradient_accumulation_steps": 16,
  "max_steps": 16000,
  "eval_interval": 500,
  "eval_iters": 50,
  "learning_rate": 3e-4,
  "min_lr": 3e-5,
  "warmup_steps": 500,
  "weight_decay": 0.1,
  "grad_clip": 1.0,
  "device": "auto",
  "seed": 42,
  "num_workers": 2,
  "use_amp": true,
  "compile": true,
  "grad_checkpoint": true,
  "log_interval": 25,
  "save_interval": 1000,
  "early_stopping_patience": 8,
  "data_dir": "data/processed_v2",
  "tokenizer_path": "artifacts/tokenizer/tokenizer_v2.json",
  "checkpoint_dir": "artifacts/checkpoints_v2",
  "log_dir": "logs_v2"
}
