  "warmup_steps": 200,
  "weight_decay": 0.1,
  "grad_clip": 1.0,
  "device": "auto",
  "seed": 42,
  "num_workers": 2,
  "use_amp": true,
  "log_interval": 25,
  "save_interval": 500,
  "early_stopping_patience": null,
  "data_dir": "data/processed",
  "tokenizer_path": "artifacts/tokenizer/tokenizer.json",
  "checkpoint_dir": "artifacts/checkpoints",
  "log_dir": "logs"
}
