{
  "vocab_size": 4096,
  "block_size": 256,
  "n_embd": 384,
  "n_head": 6,
  "n_layer": 8,
  "mlp_ratio": 4,
  "dropout": 0.1,
  "batch_size": 8,
  "gradient_accumulation_steps": 8,
  "max_steps": 5000,
  "eval_interval": 250,
  "eval_iters": 50,
  "learning_rate": 3e-4,
